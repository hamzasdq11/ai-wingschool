# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API Keys). Required to build; the publishable
# key is safe to expose — the anon role can only insert demo requests.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only — used by the Vercel Functions (api/register.ts,
# api/notify.ts). Set these in Vercel Project Settings for production;
# fill them here only to test the functions locally with `vercel dev`.
# Never expose the service role key to the client (no VITE_ prefix).
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# RESEND_API_KEY=re_...
# SUPABASE_WEBHOOK_SECRET=...
